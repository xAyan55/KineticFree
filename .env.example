# Discord OAuth2 Credentials
# Obtain these from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Admin Account Credentials (Auto-seeded into database on start)
ADMIN_EMAIL=admin@kinetichost.net
ADMIN_PASSWORD=KineticAdmin2026!

# Database Configuration
DATABASE_PATH=./data/kinetic.db
